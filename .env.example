# Public site URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://raptureatl.com

# Quote form email delivery (optional).
# Without these the /api/quote route still returns success and logs the payload to the server console.
RESEND_API_KEY=
QUOTE_TO_EMAIL=quotes@raptureatl.com
QUOTE_FROM_EMAIL=Rapture ATL Site <site@raptureatl.com>
